        },
        "mmi": {
          "type": [
            "number",
            "null"
          ],
          "description": "Predicted site intensity (MMI); absent = unknown (sent as 0).",
          "minimum": 1,
          "maximum": 12
        },
        "id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Alert id (default: 1-based order among the scenario's network alerts); updates reuse the id."
        }
      },
      "required": [
        "kind",
        "t_s",
        "magnitude",
        "r_epi_km",
        "depth_km",
        "origin_t_s"
      ],
      "additionalProperties": false
