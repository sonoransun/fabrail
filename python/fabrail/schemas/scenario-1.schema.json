    "ev_fault": {
      "type": "object",
      "description": "A sensor or driver fault applied by SimBoard.",
      "properties": {
        "kind": {
          "const": "fault"
        },
        "t_s": {
          "type": "number",
          "description": "Absolute scenario time of the event, s (0 <= t_s <= duration_s).",
          "minimum": 0
        },
        "what": {
          "enum": [
            "coil_driver",
            "lsm_driver",
            "gap_stuck",
            "gap_lost",
            "encoder_jump",
            "encoder_lost",
            "accel_stuck",
            "accel_lost",
            "imu_lost",
            "rail_accel_lost"
          ],
          "description": "Fault. coil_driver/gap_stuck/gap_lost: ch = magnet 0-7; lsm_driver/accel_stuck/imu_lost/rail_accel_lost: ch = phase/axis 0-2; encoder_jump/encoder_lost/accel_lost: ch = 0."
        },
        "ch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7,
          "default": 0,
          "description": "Channel (magnet index, axis or phase)."
        },
        "jump_m": {
          "type": [
            "number",
            "null"
          ],
          "description": "Encoder jump for what 'encoder_jump' only (default 1 mm), m. Non-zero, |jump| <= 100 m.",
          "minimum": -100,
          "maximum": 100
        }
      },
      "required": [
        "kind",
        "t_s",
        "what"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "what": {
                "enum": [
                  "lsm_driver",
                  "accel_stuck",
                  "imu_lost",
                  "rail_accel_lost"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "ch": {
                "maximum": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "what": {
                "enum": [
                  "encoder_jump",
                  "encoder_lost",
                  "accel_lost"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "ch": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "what": {
                "const": "encoder_jump"
              }
            }
          },
          "then": {
            "properties": {
              "jump_m": {
                "not": {
                  "const": 0
                }
              }
            }
          },
          "else": {
            "properties": {
              "jump_m": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "ev_network_alert": {
      "type": "object",
      "description": "A synthetic/injected network earthquake alert arrives on the alert link (fabrail is not an EEW provider; not a live feed). Requires origin_t_s <= t_s.",
      "properties": {
        "kind": {
          "const": "network_alert"
