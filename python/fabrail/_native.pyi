"""Type stub for ``fabrail._native``, the compiled Rust core (crates/fabrail-py).

Frozen in Wave 0 (W0-C1) and drift-guarded by ``tests/test_stub_drift.py``
(FAB-SW-006): every public module name, every class member and every function's
parameter names here must equal the compiled module's, in both directions.

Conventions:

- Arrays cross as little-endian ``bytes`` (``np.frombuffer(b, "<f8")``); there is no
  rust-numpy.
- SI units with unit-suffixed names (``_m``, ``_s``, ``_n``, ``_kg``, ``_a``, ...).
- Parameter paths are the dotted ``fabrail_params::meta`` paths
  (``"design.suspension.g_star_m"``; array elements by index,
  ``"design.suspension.stations.0.x_m"``) or the equivalent JSON pointer.
- Errors: ``ValueError("path: reason")`` for rejected input, ``KeyError`` for an
  unknown channel, ``NotImplementedError`` for a Wave-0 stub (the owning unit fills it),
  ``RuntimeError`` for a runtime failure.
- The ``exo_*`` / ``exo_scene_*`` functions are the sovereign/exotic tier (flat, no
  submodule; research tier unless stated). Every alert they see is synthetic or
  injected: fabrail is not an EEW provider.
"""

from typing import ClassVar

__version__: str
BUILD_PROFILE: str
BASE_TICK_HZ: int
MAX_MAGNETS: int
GOLDEN_SELFTEST_HASH: int
SCENARIO_SCHEMA: str
EXO_SCENE_SCHEMA: str

# ---------------------------------------------------------------------------------
# Classes
# ---------------------------------------------------------------------------------

class RailClass:
    """Product class of a rail (core design §C.2)."""

    DRAWER: ClassVar[RailClass]
    DOOR: ClassVar[RailClass]
    WALL: ClassVar[RailClass]
    HEAVY: ClassVar[RailClass]
    @property
    def key(self) -> str:
        """Lower-case class name ("drawer", "door", "wall", "heavy")."""
    def __int__(self) -> int: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class Params:
    """A complete, validated parameter set (fabrail_params::SystemParams)."""

    @staticmethod
    def preset(cls: str) -> Params:
        """The preset of class "drawer" | "door" | "wall" | "heavy"."""
    @staticmethod
    def from_json(s: str) -> Params:
        """Parses and validates a JSON parameter document."""
    @staticmethod
    def describe() -> list[dict[str, object]]:
        """Per-leaf metadata: path, unit, min, max, source, default_by_class."""
    def to_json(self, indent: int | None = None) -> str: ...
    def get(self, path: str) -> float | int | bool | str: ...
    def set(self, path: str, value: float | int | bool | str) -> None:
        """Sets one leaf, re-seals the safety block and re-validates; ValueError("path: reason")."""
    def with_overrides(self, overrides: dict[str, object]) -> Params: ...
    def validate(self) -> None: ...
    def derived(self) -> dict[str, float]:
        """Named derived quantities (e.g. "pole_rad_s"), fabrail_params::derive::derived."""
    @property
    def rail_class(self) -> RailClass: ...
    def __eq__(self, other: object) -> bool: ...

class Scenario:
    """A validated scenario (fabrail.scenario/1) with its decoded series."""

    @staticmethod
    def from_json(spec: str, series: dict[str, bytes] | None = None) -> Scenario:
        """Series: name -> channel-major little-endian f64 bytes."""
    def to_json(self) -> str: ...
    def series_bytes(self) -> dict[str, bytes]: ...
    @property
    def name(self) -> str: ...
    @property
    def duration_s(self) -> float: ...
    @property
    def noise_seed(self) -> int: ...

class RunData:
    """A finished run: uniform-rate channels, events, KPIs and provenance."""

    @property
    def rate_hz(self) -> float: ...
    def channel_names(self) -> list[str]: ...
    def channel(self, name: str) -> tuple[bytes, str, str]:
        """(buffer, dtype "<f8" | "u1", unit); KeyError for an unknown channel."""
    def n_samples(self) -> int: ...
    def events(self) -> list[tuple[float, str, float, float]]: ...
    def kpis(self) -> dict[str, float]: ...
    def meta_json(self) -> str: ...

class DetectorReplay:
    """Streaming seismic detector over structure acceleration (m/s², LE f64 bytes)."""

    def __init__(self, params: Params, fs_hz: float = 500.0) -> None: ...
    def feed(self, ax: bytes, ay: bytes, az: bytes) -> list[tuple[float, str, float, float]]: ...
    def report(self) -> dict[str, float]:
        """Keys: samples, duration_s, fs_hz, raw_triggers, freeze_count, protect_count, level_max."""

